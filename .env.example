# Copiez ce fichier en .env.local et remplissez les valeurs.
# Voir le README, section "Configurer Google Sheets", pour la procédure
# complète pas-à-pas.

# Email du compte de service Google (ex: ak-site@mon-projet.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Clé privée du compte de service, telle que fournie dans le fichier JSON
# téléchargé (champ "private_key"). Gardez les \n littéraux, le code les
# convertit automatiquement en vrais retours à la ligne.
GOOGLE_PRIVATE_KEY=

# ID du Google Sheet "Contenu" (dans l'URL du Sheet, entre /d/ et /edit)
GOOGLE_SHEETS_CONTENT_ID=

# ID du Google Sheet "Contacts" (mini-CRM)
# Peut être le MÊME ID que GOOGLE_SHEETS_CONTENT_ID si vous utilisez un seul
# classeur avec plusieurs onglets (Contenus / Prospects / Evenements) —
# c'est la configuration par défaut de ce projet.
GOOGLE_SHEETS_CONTACTS_ID=

# Mot de passe du tableau de bord d'administration (/admin)
ADMIN_PASSWORD=

# Clé utilisée pour signer la session admin (chaîne aléatoire, sans espace)
ADMIN_SESSION_SECRET=

# Optionnel — uniquement pour le bouton "Depuis Drive" du tableau de bord
# (choisir un fichier déjà présent dans un dossier Drive). L'import "Depuis
# mon PC" ne dépend PAS de cette variable, il fonctionne toujours.
# ID trouvable dans l'URL du dossier Drive, après /folders/.
GOOGLE_DRIVE_FOLDER_ID=

# Envoi des emails de confirmation aux prospects (inscription, téléchargement,
# demande d'info). GMAIL_USER = adresse Gmail émettrice ; GMAIL_APP_PASSWORD =
# un "mot de passe d'application" généré sur myaccount.google.com/apppasswords
# (nécessite la validation en 2 étapes activée sur ce compte Google) — ce
# n'est PAS le mot de passe normal du compte. Voir le README.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Stockage des fichiers importés ("Depuis mon PC") en production. Sur Vercel,
# créez un Blob Store (Storage → Create Database → Blob) et connectez-le au
# projet : la variable BLOB_READ_WRITE_TOKEN est alors ajoutée AUTOMATIQUEMENT
# par Vercel, ne la renseignez pas ici à la main. Sans elle, les fichiers sont
# écrits sur le disque local — parfait en développement, mais non persistant
# une fois déployé (fonctions serverless).
BLOB_READ_WRITE_TOKEN=

